# ---- Copy this file to `.env` and fill in your own values ----
#   cp .env.example .env

# ---- Database (PostgreSQL) ----
DB_NAME=safepath
DB_USER=safepath
DB_PASS=
DB_HOST=localhost
DB_PORT=5432

# ---- Django core ----
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-local-development-only-please-override-in-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- CORS ----
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# ---- Seeded accounts (used by `manage.py seed_safevoice`) ----
ADMIN_EMAIL=admin@safepath.app
ADMIN_PASSWORD=SafeVoice#2026
ADMIN_NAME=SafeVoice Administrator
INVESTIGATOR_EMAIL=investigator@safepath.app
INVESTIGATOR_PASSWORD=Investigate#2026
INVESTIGATOR_NAME=Demo Investigator

# ---- Timezone ----
TZ_NAME=UTC

# ---- Email (console backend by default) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
