PORT=5000
NODE_ENV=development
# keep the three secret keys you already have in your real .env (never share or upload that file)
JWT_SECRET=
ENCRYPTION_KEY=
NID_HMAC_KEY=
# Supabase connection string: Project > Connect > "Session pooler" > URI
# Looks like: postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase Storage (files): Project Settings > API
SUPABASE_URL=
# the SECRET key (service_role / sb_secret_...). Server only: never put it in the frontend or on GitHub.
SUPABASE_SERVICE_KEY=
# optional: name of the private bucket (created automatically)
SUPABASE_BUCKET=safevoice-files
